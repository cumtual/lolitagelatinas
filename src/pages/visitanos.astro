import LocationGrid from '../components/LocationGrid.astro';
import NuestroEspacio from '../components/NuestroEspacio.astro';
import CTAEventosVisitanos from '../components/CTAEventosVisitanos.astro';
import FooterVisitanos from '../components/FooterVisitanos.astro';
---

<Layout
  title="Visítanos | Gelatinas Lolita"
  description="Encuentra la ubicación y contacto de Gelatinas Lolita en Huajuapan de León, Oaxaca."
>
  <Header />
  <main>
    <HeroVisitanos />
    <LocationGrid />
    <NuestroEspacio />
    <CTAEventosVisitanos />
  </main>
  <FooterVisitanos />
