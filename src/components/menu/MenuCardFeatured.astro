---
import { Image } from 'astro:assets';

interface Props {
  image: string;
  name: string;
  price: string;
  description: string;
  badge: string;
  category: string;
}

const { image, name, price, description, badge, category } = Astro.props;
---

<article class="md:col-span-2 flex flex-col md:flex-row bg-white shadow-sm overflow-hidden">
  <!-- Imagen: mitad izquierda en desktop, arriba en móvil -->
  <div class="w-full md:w-1/2 aspect-4/3 overflow-hidden bg-surface-container-low">
    <Image
      src={image}
      alt={`${name} - ${category}`}
      width="600"
      height="450"
      loading="lazy"
      class="w-full h-full object-cover mt-5"
    />
  </div>

  <!-- Panel primario: mitad derecha en desktop, abajo en móvil -->
  <div class="w-full md:w-1/2 p-10 bg-primary text-on-primary flex flex-col justify-center gap-4">
    <span class="uppercase tracking-widest text-sm text-on-primary/70">
      {badge}
    </span>
    <h3 class="font-display text-2xl font-bold">
      {name}
    </h3>
    <p class="italic text-on-primary/80">
      {description}
    </p>
    <p class="font-display text-4xl font-bold">
      {price}
    </p>
    <!-- <button
      type="button"
      class="bg-secondary text-white px-6 py-3 rounded hover:bg-secondary-container transition-colors cursor-pointer"
    >
      Añadir al Pedido
    </button> -->
  </div>
</article>
