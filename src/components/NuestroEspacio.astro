---
import { Image } from "astro:assets";
---

<section aria-label="Nuestro Espacio" class="py-16 bg-surface-container">
  <div class="max-w-[var(--container-max)] mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-center">
      <!-- Imagen (md:w-1/2) -->
      <div class="w-full md:w-1/2 rounded-xl overflow-hidden soft-card-shadow border-4 border-white">
        <Image
          src="/comercio.png"
          alt="Interior del local de Gelatinas Lolita con ambiente acogedor"
          width="600"
          height="400"
          loading="lazy"
          class="w-full h-auto hover:scale-105 transition-transform duration-700"
        />
      </div>
      <!-- Texto (md:w-1/2) -->
      <div class="w-full md:w-1/2">
        <h2 class="font-display text-primary text-headline-md font-bold">Nuestro Espacio</h2>
        <div class="w-20 h-0.5 bg-secondary mt-4 mb-6"></div>
        <!-- Amenidades grid 2-col -->
        <div class="grid grid-cols-2 gap-4">
          <div class="flex items-center gap-2">
            <span
              class="material-symbols-outlined text-secondary"
              style="font-variation-settings: 'FILL' 1;"
              aria-hidden="true"
            >check_circle</span>
            <span class="font-body text-label-md text-on-surface">WiFi Gratis</span>
          </div>
          <div class="flex items-center gap-2">
            <span
              class="material-symbols-outlined text-secondary"
              style="font-variation-settings: 'FILL' 1;"
              aria-hidden="true"
            >check_circle</span>
            <span class="font-body text-label-md text-on-surface">Pet Friendly</span>
          </div>
          <div class="flex items-center gap-2">
            <span
              class="material-symbols-outlined text-secondary"
              style="font-variation-settings: 'FILL' 1;"
              aria-hidden="true"
            >check_circle</span>
            <span class="font-body text-label-md text-on-surface">Pago con Tarjeta</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
