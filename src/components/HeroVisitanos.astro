<section aria-label="Encabezado Visítanos" class="relative overflow-hidden bg-surface-bright py-16 md:py-24">
  <div class="max-w-[var(--container-max)] mx-auto px-margin-mobile md:px-margin-desktop text-center">
    <!-- Badge -->
    <span class="text-secondary font-body font-semibold text-xs tracking-widest uppercase">
      ENCUÉNTRANOS
    </span>

    <!-- Título principal -->
    <h1 class="font-display text-primary text-[48px] md:text-[64px] leading-[56px] md:leading-[72px] font-bold mt-4">
      Visítanos en el Corazón de Huajuapan
    </h1>

    <!-- Subtítulo italic -->
    <p class="text-on-surface-variant text-lg italic mt-4 max-w-2xl mx-auto">
      Descubre el sabor de la tradición oaxaqueña en un espacio diseñado para disfrutar cada bocado.
    </p>
  </div>

  <!-- Icono decorativo: temple_hindu, 300px, opacity-5, esquina inferior derecha -->
  <span class="material-symbols-outlined absolute bottom-0 right-0 text-[300px] opacity-5 text-primary" aria-hidden="true">temple_hindu</span>
</section>
